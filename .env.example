# Pixdyne site environment variables. Copy to .env.local and fill in real
# values for local development. .env.local is gitignored — never commit secrets.

# Resend API key — powers the contact form notification email AND the Free SEO
# Audit tool's lead-capture email (both send to info@pixdyne.com). Required for
# those emails to send; without it the audit PDF still downloads.
RESEND_API_KEY=

# Google PageSpeed Insights API key (optional). Used by the Free SEO Audit
# crawler (/api/seo-audit) to pull real LCP/INP/CLS field data. When unset the
# audit degrades to an HTML-size performance proxy.
PAGESPEED_API_KEY=

# Optional CRM/webhook URL for forwarding audit leads (Zapier/HubSpot/Slack).
# When unset, leads are only emailed via Resend — the webhook step is skipped.
LEAD_WEBHOOK_URL=
